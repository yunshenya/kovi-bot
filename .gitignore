target
.idea
server-login
.env
# 注意：bot.conf.toml **故意保持跟踪**，不是漏网。它是发布配置本身，并且被
# config::tests::repository_configuration_loads_with_all_sections 当作被测对象
# 钉住（thinking_mode / max_entries / 冷却时长 / 提示词里不许出现的协议字样）。
# 所以它只能写不含密的部分：密钥一律走 api_key_env / token_env 的 env 间接，
# 真实 Token 放在已忽略的 .env 里。
# 管理后台写到运行时目录的覆盖配置与自动生成的登录 Token。
# 覆盖配置里可能写着 server_config.api_key（后台的模型页会往里写），所以它连同
# 备份一起忽略；模型档案里更是每套端点各一把密钥，同样绝不入库。
bot.conf.override.toml
bot.conf.override.toml.bak.*
model_profiles.toml
model_profiles.toml.bak.*
.yunxi-admin-token
kovi.conf.toml
kovi.plugin.toml
bot_memory.json
bot_memory.json.tmp
bot_memory.json.corrupt.*
.DS_Store

# Intrinsic model runtime bundles are distributed as versioned external assets.
# Keep the default asset directory out of Git; the downloader recreates it.
/models/yunxi-intrinsic/
.dsh-computer-use/

# TurnGate bundles are generated by tools/turngate/train.py.
/models/yunxi-turngate/
# TurnGate annotation/review batches are local-only data (doc §7.4 D).
/tools/turngate/dataset/review-*.jsonl
/tools/turngate/dataset/train-*.jsonl
# 待标注工作单是同一批原文的渲染结果，同样只留在本机。
/tools/turngate/dataset/worklist-*.txt
# 管理后台「标注」页的默认目录（admin.annotation_dir = "turngate"）：开发机上
# 没有 KOVI_READY_FILE，它相对工作目录解析，也就是仓库根的这一层。里面的批次
# 与导出同样只留本机，绝不能被顺手提交。
/turngate/

# 临时：NapCat 登录二维码（登录完成后删除）
.qq-login/
