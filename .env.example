# Copy to .env for local development. Never commit real values.
OPENAI_API_KEY=CHANGE_ME
DATABASE_URL=postgresql://kovi_bot:CHANGE_ME@127.0.0.1:5432/kovi_bot

# Optional reconstructable runtime state.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=kovi

